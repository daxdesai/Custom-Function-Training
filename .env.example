# Google Apps Script web app URL.
# Deploy the script in google-apps-script/Code.gs, then paste the /exec URL here.
# Set this to mock if you want to preview the success state without writing to a sheet.
NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=

# Canonical site URL used for metadata, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
